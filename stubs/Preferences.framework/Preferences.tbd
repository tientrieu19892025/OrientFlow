                       PSRootController, PSListItemsController, PSControlTableCell,
                       PSSwitchTableCell, PSSliderTableCell, PSEditableTableCell,
                       PSBundleController, PSHeaderFooterView ]
    objc-ivars:      [ _OBJC_IVAR_$_PSListController._specifiers ]
...
